# Release 签名凭据模板。
#
# 复制成 keystore.properties 并填入真实值（该文件已被 .gitignore 忽略，不会入库）。
# 缺少 keystore.properties 时 release 仍能构建，只是产出未签名的 APK。
#
# 生成一个新的 keystore：
#   keytool -genkeypair -v \
#     -keystore release.keystore \
#     -alias pomodoro \
#     -keyalg RSA -keysize 2048 -validity 10000 \
#     -storepass <你的密码> -keypass <你的密码> \
#     -dname "CN=Pomodoro Timer, OU=Personal, O=Pomodoro Timer, L=Unknown, ST=Unknown, C=CN"
#
# storeFile 的路径相对于 app/ 模块，所以项目根目录下的 keystore 写 ../release.keystore

storeFile=../release.keystore
storePassword=
keyAlias=pomodoro
keyPassword=
